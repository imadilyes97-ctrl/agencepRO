    "next-auth": "^5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.8.0",
    "zod": "^3.24.0",
    "bcryptjs": "^2.4.3",
    "@sentry/nextjs": "^8.50.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "resend": "^4.1.0",
    "framer-motion": "^12.0.0",
    "recharts": "^2.15.0",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.0",
    "lucide-react": "^0.469.0",
